<aside class="sidebar">
    <div class="sidebar-top">
        <div class="sidebar-username"><%= user.username %></div>
        <div class="sidebar-bttn">
            <img class="open-folder-modal sidebar-icon" src="/images/folder-plus.svg" alt="Add folder">
            <img class="open-upload-modal sidebar-icon" src="/images/file-plus.svg" alt="Add file">
        </div>
    </div>
    <div class="sidebar-content">
        <div class="folder-list">
            <% sidebarFolders.forEach(folder => { %>
                <div class="sidebar-folder-item">
                    <a href="/folders/<%= folder.id %>" class="folder-link">
                        <img class="folder-icon" src="/images/folder-colour.svg" alt="Folder">
                        <span><%= folder.name %></span>
                    </a>

                    <div class="folder-menu">
                        <button class="item-options">⋮</button>
                        <%- include('dropdown', { folder: folder }) %>
                    </div>
                </div>
            <% }) %>
        </div>
        <div class="file-list">
            <% sidebarFiles.forEach(file => { %>
                <div class="sidebar-file-item">
                    <a href="<%= file.url %>" class="file-link">
                        <img class="file-icon" src="/images/file-outline.svg">
                        <span><%= file.name %></span>
                    </a>

                    <div class="folder-menu">
                        <button class="item-options">⋮</button>
                        <%- include('file-dropdown', { file }) %>
                    </div>
                </div>
            <% }) %>

        </div>
    </div>
</aside>