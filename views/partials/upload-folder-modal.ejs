<div class="modal folder-modal hidden">
    <div class="modal-content">
        <div class="modal-top">
            <h2 id="folder-modal-title">New Folder</h2>
            <button class="close-folder-modal close">&times;</button>
        </div>

        <form class="modal-form" id="folder-form" method="POST" action="/folders">
            <input type="hidden" id="parent-id" name="parentId" value="<%= currentFolderId || '' %>">

            <label for="folder-name">Folder name</label>
            <input type="text" id="folder-name" name="folderName" required>

            <button class="modal-submit" type="submit">Submit</button>
        </form>
    </div>
</div>