<div class="modal folder-modal hidden">
    <div class="modal-content">
        <h2 id="folder-modal-title">New Folder</h2>

        <button class="close-folder-modal close">&times;</button>

        <form id="folder-form" method="POST" action="/folders">
            <input type="hidden" id="folder-id" name="folderId">

            <label for="folder-name">Folder name</label>
            <input type="text" id="folder-name" name="folderName" required>

            <button type="submit" id="folder-submit-btn">Submit</button>
        </form>
    </div>
</div>