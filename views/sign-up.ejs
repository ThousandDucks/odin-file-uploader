<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <main>
        <form action="/sign-up" method="POST">
            <div>
                <h1>Create an account</h1>
                <!-- Cannot use if (error) as empty list is counted as true -->
                <% if (errors.length > 0) { %>
                    <ul class="error-list">
                        <% errors.forEach((error) => { %>
                            <li><%= error.msg %></li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
            <div class="sign-up-container">
                <label for="username">Username</label>
                <input id="username" name="username" type="text" value="<%= data.username || '' %>" required/>
                <span id="username-message"></span>

                <label for="password">Password</label>
                <input id="password" name="password" type="password" required/>
                <span id="password-message"></span>

                <label for="confirmPassword">Confirm Password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" required/>
                <span id="confirm-password-message"></span>
            </div>
            <button class="sign-up-bttn" type="submit">Create Account</button>
            <div class="log-in-redirect">
                <div>Already have an account? <a href="/log-in">Log in</a></div>
            </div>
        </form>
        <script src="/js/signup.js"></script>
    </main>
    <%- include('partials/footer') %>
</body>
</html>